# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais committer .env.local.
#
# Les variables NEXT_PUBLIC_* sont envoyées au navigateur : elles sont PUBLIQUES.
# N'y mettez jamais une clé secrète.

# URL publique du site (sert aux liens absolus, e-mails, redirections Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- À venir (back-end) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=          # serveur uniquement
# STRIPE_SECRET_KEY=            # serveur uniquement
# STRIPE_WEBHOOK_SECRET=        # serveur uniquement
